<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Class-D RF Covert Transmitter"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Receiver Setup:\n• Set Radio to 144.000 MHz (AM Mode)\n• Set Squelch = 0 (Open Hiss)\n• Maximize Media Volume to 100%\n• Touch radio antenna to the bottom speaker grill"
        android:textSize="12sp"
        android:textColor="#888888"
        android:padding="8dp"
        android:layout_marginBottom="16dp" />


    <EditText
        android:id="@+id/etMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter text (e.g. CQ CQ DE TA1EEI)"
        android:text="SOS"
        android:textAllCaps="true"
        android:inputType="textNoSuggestions|textVisiblePassword"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnTransmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Morse Transmission" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Status: Ready (Set volume to 100%)"
        android:fontFamily="monospace"
        android:textSize="13sp" />


    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Please don't forget to share your feedback via GitHub or by emailing me at 2007efeisik@gmail.com\n— TA1EEI"
        android:textSize="13sp"
        android:textStyle="italic"
        android:textAlignment="center"
        android:layout_marginBottom="12dp" />


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WARNING: This app generates 21 kHz ultrasonic frequencies which may be disturbing to animals. By using this application, you assume full responsibility for any hardware damage, compliance issues, or other consequences. The developer assumes no liability."
        android:textSize="11sp"
        android:textColor="#888888"
        android:textAlignment="center" />

</LinearLayout>
